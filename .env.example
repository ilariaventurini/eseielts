# Firebase (client) — VITE_ prefix exposes values to the browser bundle
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: full function URL if you use plain `yarn dev` (Vite only). Example with functions on port 9999:
# VITE_GEMINI_FEEDBACK_URL=http://localhost:9999/.netlify/functions/gemini-feedback
# VITE_GEMINI_WRITING_SOLUTION_URL=http://localhost:9999/.netlify/functions/gemini-writing-solution
# Otherwise prefer `yarn dev:netlify` and leave this unset.

# Netlify only (dashboard / Netlify env — never VITE_)
# GEMINI_API_KEY=

# Firebase backup script (local + GitHub Actions — never VITE_, never commit)
# Generate: Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or paste the full JSON for CI:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

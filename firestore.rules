rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Writing prompts (backoffice + random draw): any signed-in user
    match /writingPrompts/{docId} {
      allow read, write: if request.auth != null;
    }

    // Saved attempts + feedback: any signed-in user
    match /writingAttempts/{docId} {
      allow read, write: if request.auth != null;
    }

    match /speakingPrompts/{docId} {
      allow read, write: if request.auth != null;
    }

    match /speakingAttempts/{docId} {
      allow read, write: if request.auth != null;
    }

    // Section seeding (listening / reading / speaking backoffice)
    match /listeningContent/{docId} {
      allow read, write: if request.auth != null;
    }

    match /readingContent/{docId} {
      allow read, write: if request.auth != null;
    }

    match /speakingContent/{docId} {
      allow read, write: if request.auth != null;
    }

    // IELTS help markdown (tab id = document id, e.g. study-tips)
    match /helpDocs/{tabId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
